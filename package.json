{
  "name": "tangerine-tools",
  "private": true,
  "version": "0.1.1",
  "description": "洛克王国世界收藏、性格与繁育助手，数据保存在本机",
  "author": "TangerineTools contributors",
  "homepage": "https://github.com/Manamiiii/TangerineTools",
  "repository": { "type": "git", "url": "https://github.com/Manamiiii/TangerineTools.git" },
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "check:privacy": "node scripts/check-privacy.mjs",
    "preview": "vite preview",
    "check:nature": "node scripts/nature/check-recommendations.mjs",
    "check:scanner:templates": "node scripts/rock-kingdom-scanner/build-templates.mjs",
    "apply:scanner:templates": "node scripts/rock-kingdom-scanner/build-templates.mjs --write",
    "sync:breeding": "node scripts/bwiki/sync-breeding.mjs",
    "check:official-announcements": "node scripts/bwiki/check-official-announcements.mjs",
    "sync:bwiki:staging": "node scripts/bwiki/sync-staging.mjs",
    "sync:bwiki:details": "node scripts/bwiki/sync-details.mjs",
    "sync:bwiki:nrc": "node scripts/bwiki/sync-nrc.mjs",
    "collect:bwiki:browser": "node scripts/bwiki/collect-nrc-browser.mjs",
    "import:bwiki:nrc": "node scripts/bwiki/import-nrc-snapshot.mjs",
    "preview:bwiki:nrc": "node scripts/bwiki/build-preview.mjs --source=nrc",
    "audit:bwiki:nrc": "node scripts/bwiki/audit-nrc.mjs",
    "review:bwiki:nrc": "node scripts/bwiki/review-nrc.mjs",
    "check:bwiki:nrc": "node scripts/bwiki/apply-preset.mjs --source=nrc",
    "check:bwiki:sources": "node scripts/bwiki/check-sources.mjs --source=nrc",
    "preview:bwiki": "node scripts/bwiki/build-preview.mjs",
    "check:bwiki:preset": "node scripts/bwiki/apply-preset.mjs --source=nrc",
    "apply:bwiki:preset": "node scripts/bwiki/apply-preset.mjs --write",
    "test": "node --test scripts/tests/*.test.mjs",
    "build:icons": "node scripts/assets/build-icons.mjs",
    "pack:desktop": "npm run build && node desktop/build.mjs --dir",
    "dist:windows": "npm run build && node desktop/build.mjs && npm run checksums:desktop",
    "build:installer-fixtures": "npm run build && node desktop/build.mjs --fixtures",
    "checksums:desktop": "node desktop/checksums.mjs",
    "test:desktop": "node desktop/tests/smoke.mjs",
    "test:installer": "node desktop/tests/installer.mjs",
    "test:installer:production": "node desktop/tests/installer.mjs --production"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "fake-indexeddb": "^6.2.4",
    "oxlint": "^1.74.0",
    "parse5": "^8.0.1",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.5",
    "vite": "~8.1.6"
  }
}
