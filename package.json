{
  "name": "tangerine-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:nature": "node scripts/nature/check-recommendations.mjs",
    "check:scanner:templates": "node scripts/rock-kingdom-scanner/build-templates.mjs",
    "apply:scanner:templates": "node scripts/rock-kingdom-scanner/build-templates.mjs --write",
    "sync:breeding": "node scripts/bwiki/sync-breeding.mjs",
    "check:official-announcements": "node scripts/bwiki/check-official-announcements.mjs",
    "sync:bwiki:staging": "node scripts/bwiki/sync-staging.mjs",
    "sync:bwiki:details": "node scripts/bwiki/sync-details.mjs",
    "sync:bwiki:nrc": "node scripts/bwiki/sync-nrc.mjs",
    "collect:bwiki:browser": "node scripts/bwiki/collect-nrc-browser.mjs",
    "import:bwiki:nrc": "node scripts/bwiki/import-nrc-snapshot.mjs",
    "preview:bwiki:nrc": "node scripts/bwiki/build-preview.mjs --source=nrc",
    "audit:bwiki:nrc": "node scripts/bwiki/audit-nrc.mjs",
    "check:bwiki:nrc": "node scripts/bwiki/apply-preset.mjs --source=nrc",
    "check:bwiki:sources": "node scripts/bwiki/check-sources.mjs",
    "preview:bwiki": "node scripts/bwiki/build-preview.mjs",
    "check:bwiki:preset": "node scripts/bwiki/apply-preset.mjs",
    "apply:bwiki:preset": "node scripts/bwiki/apply-preset.mjs --write",
    "test": "node --test scripts/tests/*.test.mjs"
