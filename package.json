  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.4",
    "oxlint": "^1.74.0",
    "parse5": "^8.0.1",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "vite": "^8.1.5"
  }
